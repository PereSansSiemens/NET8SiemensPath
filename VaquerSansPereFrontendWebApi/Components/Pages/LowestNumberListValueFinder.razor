@page "/lowestNumListValue"
<!-- #region C#Code -->
@using VaquerSansPereFrontendWebApi.Services.Interfaces

@rendermode InteractiveServer

@inject IFindLowestValueService _findLowestValueService

@code
{
    private class NumberItem
    {
        public int Value { get; set; }
    }

    private List<NumberItem> NumList { get; set; } = new();
    private int LowestValue;

    private void AddNum()
    {
        NumList.Add(new NumberItem());
    }

    protected async Task GetLowestValue()
    {
        var RawList = NumList.Select(x => x.Value).ToList();
        LowestValue = await _findLowestValueService.FindLowestValue(list: RawList);
    }
}

<!-- #endregion -->

<!-- #region HTML -->

<h3>Lowest value calculator</h3>

@foreach (var item in NumList)
{
    <input type="number" step="any" @bind="item.Value" />
    <br />
}
<br />
<button @onclick="AddNum">Add number to list</button>
<button @onclick="GetLowestValue">Show lowest value</button>

<p>@LowestValue</p>

<!-- #endregion -->
